# Behind a reverse proxy $remote_addr is the PROXY's address, so every user
# shared one rate-limit bucket (and the auth server saw one IP too). Trust the
# forwarded address only from the docker networks the proxy can live on.
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 127.0.0.1;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Credential endpoints stay tight — this zone exists to stop password
# guessing, and nothing legitimate calls them in a loop.
limit_req_zone $binary_remote_addr zone=auth_api:10m rate=20r/m;
# /auth/sync/* is the DATA path: a pull on every app focus plus one batched
# push per edit burst, and a rejected push retries every 5s. Under the 20r/m
# credential limit a few minutes of normal editing pinned every write at 429
# — the client kept saying "not sent to the server yet" while the retry loop
# itself ate the whole budget.
limit_req_zone $binary_remote_addr zone=sync_api:10m rate=120r/m;
limit_req_status 429;

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Security headers
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https: wss:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'" always;

  location = /health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # nginx defaults client_max_body_size to 1m, and it was never set. A push
  # carrying a project's spec attachment (base64, easily >1m) got an HTML
  # "413 Request Entity Too Large" page — which the client's authFetch tries
  # to JSON.parse, fails, and treats as a generic failure, so it retried the
  # same oversized body forever. Keep the ceiling, but set it deliberately
  # and above what the auth service itself accepts (AUTH_MAX_BODY_BYTES,
  # 12m), so the service returns a JSON 413 the client can actually read.
  client_max_body_size 14m;
  client_body_timeout 30s;

  location /rest/v1/ {
    proxy_pass http://postgrest:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # More specific than /auth/ below, so nginx routes the sync traffic here.
  location /auth/sync/ {
    limit_req zone=sync_api burst=60 nodelay;
    proxy_pass http://auth:3001/auth/sync/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  location /auth/ {
    limit_req zone=auth_api burst=10 nodelay;
    proxy_pass http://auth:3001/auth/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  location = /sw.js {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    try_files $uri =404;
  }

  location = /config.js {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    try_files $uri =404;
  }

  location = /manifest.json {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    try_files $uri =404;
  }

  location ~ ^/(apple-touch-icon|icon-192|icon-512)\.png$ {
    add_header Cache-Control "public, max-age=3600, must-revalidate";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
