# Copy to .env and run: ./scripts/setup.sh
# setup.sh generates secrets and ANON_KEY automatically.

# Public URL (used by PostgREST OpenAPI; no trailing slash)
PUBLIC_URL=http://localhost:8080

# Domain for automatic HTTPS (tls deploy mode only)
PUBLIC_HOST=

# HTTP port exposed on the host
HTTP_PORT=8080

# Bind address for web port (127.0.0.1 or 0.0.0.0; use 0.0.0.0 with NPM in Docker)
BIND_ADDRESS=127.0.0.1

# Auto-connect frontend to the bundled database API
AUTO_CONNECT=true

# PostgreSQL
POSTGRES_DB=timelog
POSTGRES_USER=timelog
POSTGRES_PASSWORD=change_me_postgres_password

# PostgREST authenticator role password (internal)
AUTHENTICATOR_PASSWORD=change_me_authenticator_password

# JWT secret for PostgREST (min 32 characters)
JWT_SECRET=change_me_jwt_secret_min_32_characters_long

# Generated by scripts/setup.sh — do not edit manually
ANON_KEY=
